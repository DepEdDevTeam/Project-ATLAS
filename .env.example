OPENAI_LLM_KEY=
# Optional model override for the server-side migration agents.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SEARCH_MODEL=gpt-5-mini

# Browser-visible token. Restrict it in Mapbox to the app's allowed URLs.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Firebase web configuration. The API key identifies the Firebase project; it is
# intentionally sent to the browser and is not a service-account secret.
FIREBASE_PROJECT_ID=depedprototype
FIREBASE_DATABASE_ID=(default)
FIREBASE_API_KEY=
